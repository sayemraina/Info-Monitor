# LLM key — OpenRouter (primary) or Anthropic (fallback)
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
OPENAI_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=narrative_monitor/1.0
YOUTUBE_API_KEY=
X_BEARER_TOKEN=

# Frontend — set to enable Live Topic Input (requires FastAPI server running)
# Leave blank for demo/static mode (no server needed)
VITE_API_BASE_URL=

# Scheduler config — runs when ENABLE_SCHEDULER=true and FastAPI server is up
ENABLE_SCHEDULER=true
SCHEDULER_INTERVAL_HOURS=24
# Comma-separated ingester names to skip during scheduled runs (e.g. x to save API costs)
SCHEDULER_EXCLUDE_INGESTERS=x
